# Copy to .env and fill in. Only OPENROUTER_API_KEY is needed to start.
OPENROUTER_API_KEY=

# Optional direct-provider keys, used only if config/models.yaml points a role at them.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Spend and abuse controls
TADABBUR_MAX_LLM_CALLS_PER_DAY=2000
TADABBUR_RATE_LIMIT_PER_MINUTE=20
TADABBUR_CANDIDATES=40
# TADABBUR_CACHE=true
# TADABBUR_DATA_DIR=./data
